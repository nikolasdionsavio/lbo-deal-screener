# ----- Backend -----

# SQLite by default for zero-config local runs. Docker compose overrides this with Postgres.
DATABASE_URL=sqlite:///./lbo_screener.db

# Secret used to sign JWT auth tokens (HS256 — use at least 32 bytes of randomness).
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_generate_a_random_48_byte_secret_for_real_use

# Data provider mode: auto | mock | live | yahoo
#   auto  = yahoo when the yfinance package is installed, else live when SEC_EDGAR_USER_AGENT is set, else bundled sample data
#   mock  = always use bundled sample data (no network calls; offline/dev mode)
#   live  = SEC EDGAR fundamentals + FMP market data; errors if SEC_EDGAR_USER_AGENT is missing
#   yahoo = global live data (US + UK + EU) via Yahoo Finance unofficial endpoints; needs no API key, only the yfinance package
DATA_PROVIDER=auto

# SEC EDGAR requires a descriptive User-Agent with contact info (no API key needed).
# In yahoo/auto mode, setting this upgrades US-ticker fundamentals to official SEC EDGAR data.
# Example: "LBO Deal Screener your_email@example.com"
SEC_EDGAR_USER_AGENT=

# Financial Modeling Prep API key for market data (share price, market cap, profile).
# Free tier: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost:3000

# ----- Frontend -----

# Base URL the browser uses to reach the FastAPI backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
